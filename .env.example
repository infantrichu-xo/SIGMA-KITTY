# Copy this file to ".env" and fill in your values. Never commit .env or
# share your real token publicly.

# Bot token from https://discord.com/developers/applications -> your app -> Bot
DISCORD_TOKEN=your_bot_token_here

# Prefix for old-style text commands (slash commands work regardless)
PREFIX=!

# Optional: set this to your test server's ID while developing so slash
# commands sync instantly instead of waiting up to an hour for global sync.
DEV_GUILD_ID=

# Optional: only needed for /play with open.spotify.com links.
# Create a free app at https://developer.spotify.com/dashboard to get these.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Optional but REQUIRED for Spotify PLAYLIST and ALBUM links specifically
# (single track links work with just the two values above). Spotify now
# requires a real user login for playlist/album lookups -- generate this
# by running `python get_spotify_refresh_token.py` once. See README.md.
SPOTIFY_REFRESH_TOKEN=

# Only needed if you set SPOTIFY_REFRESH_TOKEN above via a custom redirect
# URI. Must exactly match a Redirect URI added in your Spotify dashboard
# app settings. Defaults to http://127.0.0.1:8888/callback if left blank.
SPOTIFY_REDIRECT_URI=
